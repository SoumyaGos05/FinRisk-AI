# Environment variable template.
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit the .env file — it is listed in .gitignore.

# SQLite (default for local development):
DATABASE_URL=sqlite:///./finrisk.db

# Set to "production" when deploying.
APP_ENV=development

# ---------------------------------------------------------------------------
# AI Explanation Engine — Google Gemini (optional)
# ---------------------------------------------------------------------------
# Obtain a free API key from https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY unset or empty to disable AI explanations entirely.
# The deterministic financial engine always works without these settings.
# NEVER commit your actual API key — set it in your deployment environment only.
GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=10
